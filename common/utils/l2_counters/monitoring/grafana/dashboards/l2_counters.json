{
  "uid": "oai-l2-counters",
  "title": "OAI L2 counters",
  "tags": [
    "oai",
    "l2"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "node",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-l2"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"l2_counters\", tag: \"node\")",
        "definition": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"l2_counters\", tag: \"node\")",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {},
        "options": []
      },
      {
        "name": "field",
        "label": "field",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-l2"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.fieldKeys(bucket: \"l2_counters\", predicate: (r) => r.node == \"${node}\")",
        "definition": "import \"influxdata/influxdb/schema\"\nschema.fieldKeys(bucket: \"l2_counters\", predicate: (r) => r.node == \"${node}\")",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {},
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "gNB MAC",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "gNB DL throughput (new TBs)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-l2"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-l2"
          },
          "query": "from(bucket: \"l2_counters\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"l2_counters\" and r.node == \"gNB\" and r._field == \"dl_tx_bytes\")\n  |> aggregateWindow(every: v.windowPeriod, fn: last, createEmpty: false)\n  |> derivative(unit: 1s, nonNegative: true)\n  |> map(fn: (r) => ({r with _value: r._value * 8.0 / 1000000.0}))\n  |> keep(columns: [\"_time\", \"_value\", \"_field\", \"group\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Mbits",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
